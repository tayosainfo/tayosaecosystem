# Web app (Vite)
VITE_API_BASE_URL=http://localhost:8080
VITE_INSFORGE_BASE_URL=https://74qj9u5z.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=your-insforge-anon-key

# Backend service integration points
INSFORGE_BASE_URL=https://74qj9u5z.us-east.insforge.app
INSFORGE_ANON_KEY=your-insforge-anon-key
# Optional: used to resolve InsForge user id after sign-up when the JSON body omits user.id (e.g. some requireEmailVerification responses).
INSFORGE_ADMIN_API_KEY=your-insforge-admin-key
INSFORGE_STORAGE_BUCKET=collateral_docs
# When INSFORGE_BASE_URL + INSFORGE_ANON_KEY are set, user-service uses live InsForge
# for sign-up, login, email verification, password reset, OAuth PKCE, refresh, logout, and profile
# (same REST paths as @insforge/sdk). Configure allowedRedirectUrls in the InsForge dashboard for OAuth
# and email links; use ?client_type=mobile (etc.) on auth routes when you need refreshToken in JSON.
#
# If InsForge returns errors like "No backend services available for app: …", fix the project
# in the InsForge dashboard, OR for purely local dev comment out BOTH lines below so register/login
# use the in-memory / bcrypt path (no InsForge HTTP calls).

# Service routing defaults (gateway)
USER_SERVICE_URL=http://localhost:8081
OBJECT_STORAGE_SERVICE_URL=http://localhost:8015
AFFILIATE_SERVICE_URL=http://localhost:8016
NOTIFICATION_SERVICE_URL=http://localhost:8010
AUDIT_SERVICE_URL=http://localhost:8014
LOAN_SERVICE_URL=http://localhost:8013
FEE_SERVICE_URL=http://localhost:8004
KIBIINA_SERVICE_URL=http://localhost:8086

# user-service persistence (optional). Apply db/migrations/*.sql first.
#
# Use ONE of:
#   • Local Docker: DATABASE_URL=postgres://tayosa:password@localhost:5432/tayosa_banking?sslmode=disable
#   • InsForge dashboard connection string (project must be active, not paused):
#       DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/insforge?sslmode=require
#     You may also set the same value as CONNECTION_STRING; user-service accepts either.
#
# .env format must be KEY=value (not "HOST: value"). Invalid lines are ignored.
# If cloud DB is unreachable: omit DATABASE_URL or set USER_SERVICE_ALLOW_MEMORY_FALLBACK=1
