# Web app (Vite)
VITE_API_BASE_URL=http://localhost:8080

# Supabase Configuration (Frontend)
# VITE_SUPABASE_URL: Your Supabase project URL (found in Project Settings > API)
# Used by the frontend to connect to Supabase services (auth, database, storage)
VITE_SUPABASE_URL=https://ablvrbnbsdqshrorhmjf.supabase.co

# VITE_SUPABASE_ANON_KEY: Public anonymous key for client-side operations
# Safe to expose in frontend code - provides read access with Row Level Security (RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend service — Supabase Auth
# SUPABASE_URL: Your Supabase project URL for backend services
# Same as VITE_SUPABASE_URL but used by backend microservices
SUPABASE_URL=https://ablvrbnbsdqshrorhmjf.supabase.co

# SUPABASE_ANON_KEY: Public anonymous key for backend client-side operations
# Same as VITE_SUPABASE_ANON_KEY but used by backend services
SUPABASE_ANON_KEY=your-supabase-anon-key

# SUPABASE_SERVICE_ROLE_KEY: Secret key for privileged backend operations
# ⚠️ NEVER expose this key in frontend code or commit to version control
# Used for admin operations like user lookup, bypassing RLS, and service-to-service auth
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_API_KEY=change-me-admin-secret
VITE_ADMIN_API_KEY=change-me-admin-secret

# Service routing defaults (gateway)
USER_SERVICE_URL=http://localhost:8081
OBJECT_STORAGE_SERVICE_URL=http://localhost:8015
AFFILIATE_SERVICE_URL=http://localhost:8016
NOTIFICATION_SERVICE_URL=http://localhost:8010
AUDIT_SERVICE_URL=http://localhost:8014
LOAN_SERVICE_URL=http://localhost:8013
FEE_SERVICE_URL=http://localhost:8004
KIBIINA_SERVICE_URL=http://localhost:8086

# user-service persistence (optional). Apply db/migrations/*.sql first.
#
# Use ONE of:
#   • Local Docker: DATABASE_URL=postgres://tayosa:password@localhost:5432/tayosa_banking?sslmode=disable
#   • Supabase connection string:
#       DATABASE_URL=postgresql://postgres:PASSWORD@db.ablvrbnbsdqshrorhmjf.supabase.co:5432/postgres?sslmode=require
#
# If cloud DB is unreachable: omit DATABASE_URL or set USER_SERVICE_ALLOW_MEMORY_FALLBACK=1
